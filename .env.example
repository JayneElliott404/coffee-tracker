# Copy this file to .env and fill in your own values. Never commit .env.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/podcafe-dev?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Emails (confirm email, forgot password) are sent with Resend: https://resend.com/api-keys
# Leave RESEND_API_KEY empty in development and the email (with its link) is printed to the console instead.
# It is required when NODE_ENV=production. Emails are sent from noreply@nespresso-tracker.com.
RESEND_API_KEY=
# Public address of the site, used to build the links in emails (no trailing slash).
# Required when NODE_ENV=production, e.g. https://nespresso-tracker.com
APP_URL=http://localhost:3000
# Google tag (Tag Manager container ID, e.g. GTM-XXXXXXX). Optional: when empty there is no cookie banner and no analytics.
# The tag is only loaded in the browser after the visitor accepts analytics cookies.
GOOGLE_TAG_ID=
PORT=3000
NODE_ENV=development
