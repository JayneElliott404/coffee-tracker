<div class="col">
  <article class="card card-cafe pod-card h-100">
    <div class="card-body d-flex flex-column">
      <% if (pod.brand) { %>
      <p class="small text-muted text-uppercase mb-1"><%= pod.brand %></p>
      <% } %>
      <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
        <h2 class="h5 card-title mb-0"><%= pod.name %></h2>
        <span class="score-badge <%= scoreClass(pod.score) %>" title="Score out of 10"><%= formatScore(pod.score) %></span>
      </div>
      <div class="intensity mb-2" role="img" aria-label="Intensity <%= pod.intensity %> of 13">
        <% for (let i = 1; i <= 13; i++) { %><span class="bean<%= i <= pod.intensity ? ' filled' : '' %>"></span><% } %>
        <span class="small text-muted ms-1">Intensity <%= pod.intensity %></span>
      </div>
      <% if (pod.flavour) { %>
      <p class="flavour mb-2"><i class="bi bi-flower1 me-1"></i><%= pod.flavour %></p>
      <% } %>
      <% if (pod.notes) { %>
      <p class="notes small text-muted mb-2"><%= pod.notes %></p>
      <% } %>
      <div class="mt-auto d-flex justify-content-between align-items-center pt-2">
        <small class="text-muted"><i class="bi bi-calendar3 me-1"></i><%= formatDate(pod.dateTried) %></small>
        <% if (!locals.readOnly) { %>
        <div class="d-flex gap-1">
          <a class="btn btn-sm btn-outline-espresso" href="/pods/<%= pod._id %>/edit" aria-label="Edit <%= pod.name %>"><i class="bi bi-pencil"></i></a>
          <form method="post" action="/pods/<%= pod._id %>/delete" class="m-0" data-confirm="Delete <%= pod.name %>? This cannot be undone.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Delete <%= pod.name %>"><i class="bi bi-trash"></i></button>
          </form>
        </div>
        <% } %>
      </div>
    </div>
  </article>
</div>
