<%
  const user = locals.currentUser;
  const navItems = [
    { href: '/pods', label: 'My Pods', icon: 'cup-hot' },
    { href: '/pods/new', label: 'Add Pod', icon: 'plus-circle' },
    { href: '/stats', label: 'Stats', icon: 'bar-chart' },
  ];
  if (user && user.isAdmin) navItems.push({ href: '/admin/users', label: 'Admin', icon: 'shield-lock' });
  const current = locals.path || '';
%>
<nav class="navbar navbar-expand-md navbar-dark navbar-cafe shadow-sm">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <%- include('logo', { size: 44 }) %>
      <span class="brand-text">Nespresso Tracker</span>
    </a>
    <% if (user) { %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto ms-md-3">
        <% for (const item of navItems) { const active = current === item.href || (item.href === '/admin/users' && current.startsWith('/admin')); %>
        <li class="nav-item">
          <a class="nav-link<%= active ? ' active' : '' %>" href="<%= item.href %>"<%- active ? ' aria-current="page"' : '' %>>
            <i class="bi bi-<%= item.icon %> me-1"></i><%= item.label %>
          </a>
        </li>
        <% } %>
      </ul>
      <div class="d-flex align-items-center gap-2 pb-2 pb-md-0">
        <span class="navbar-text small me-1"><i class="bi bi-person-circle me-1"></i><%= user.username %></span>
        <a href="/account/password" class="btn btn-sm btn-outline-light" title="Change password" aria-label="Change password"><i class="bi bi-key"></i></a>
        <form method="post" action="/logout" class="m-0">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
          <button class="btn btn-sm btn-crema" type="submit">Log out</button>
        </form>
      </div>
    </div>
    <% } %>
  </div>
</nav>
