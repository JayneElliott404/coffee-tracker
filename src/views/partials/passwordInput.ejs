<% const fieldError = locals.error; %>
<div class="input-group has-validation">
  <input id="<%= id %>" name="<%= name %>" type="password" class="form-control<%= fieldError ? ' is-invalid' : '' %>" autocomplete="<%= autocomplete %>" required<%= locals.autofocus ? ' autofocus' : '' %><%- locals.minlength ? ` minlength="${minlength}"` : '' %>>
  <button class="btn btn-outline-espresso" type="button" data-password-toggle="<%= id %>" aria-label="Show password" aria-pressed="false"><i class="bi bi-eye"></i></button>
  <% if (fieldError) { %><div class="invalid-feedback"><%= fieldError.msg %></div><% } %>
</div>
