<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-sm-10 col-md-7 col-lg-5">
    <div class="card card-cafe auth-card">
      <div class="card-body p-4 p-md-5 text-center">
        <%- include('../partials/logo', { size: 80 }) %>
        <h1 class="h3 mt-3">Confirm your email</h1>
        <p class="text-muted">One more click and you're ready to start rating pods.</p>
        <form method="post" action="/confirm-email/<%= token %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-espresso w-100" type="submit">Confirm my email</button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
