<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-sm-10 col-md-7 col-lg-5">
    <div class="card card-cafe auth-card">
      <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
          <%- include('../partials/logo', { size: 80 }) %>
          <h1 class="h3 mt-3">Pull up a chair</h1>
          <p class="text-muted mb-0">Create an account to start rating your pods.</p>
        </div>
        <form method="post" action="/register" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input id="username" name="username" class="form-control<%= errors.username ? ' is-invalid' : '' %>" value="<%= values.username || '' %>" autocomplete="username" required autofocus aria-describedby="usernameHelp">
            <% if (errors.username) { %><div class="invalid-feedback"><%= errors.username.msg %></div><% } %>
            <div id="usernameHelp" class="form-text">3–30 characters: letters, numbers, dots, dashes or underscores.</div>
          </div>
          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input id="password" name="password" type="password" class="form-control<%= errors.password ? ' is-invalid' : '' %>" autocomplete="new-password" required minlength="8">
            <% if (errors.password) { %><div class="invalid-feedback"><%= errors.password.msg %></div><% } %>
          </div>
          <div class="mb-4">
            <label for="confirmPassword" class="form-label">Confirm password</label>
            <input id="confirmPassword" name="confirmPassword" type="password" class="form-control<%= errors.confirmPassword ? ' is-invalid' : '' %>" autocomplete="new-password" required>
            <% if (errors.confirmPassword) { %><div class="invalid-feedback"><%= errors.confirmPassword.msg %></div><% } %>
          </div>
          <button class="btn btn-espresso w-100" type="submit">Create account</button>
        </form>
        <p class="text-center mt-4 mb-0 small">Already a regular? <a href="/login">Log in</a></p>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
