<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-sm-10 col-md-7 col-lg-5">
    <div class="card card-cafe auth-card">
      <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
          <%- include('../partials/logo', { size: 80 }) %>
          <h1 class="h3 mt-3">Welcome back</h1>
          <p class="text-muted mb-0">Log in to see your pod collection.</p>
        </div>
        <% if (errors.form) { %>
        <div class="alert alert-danger" role="alert"><%= errors.form.msg %><% if (errors.form.resend) { %> <a href="/confirm-email/resend" class="alert-link">Send it again</a><% } %></div>
        <% } %>
        <form method="post" action="/login" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="username" class="form-label">Email address</label>
            <input id="username" name="username" type="email" class="form-control" value="<%= values.username || '' %>" autocomplete="username" required autofocus>
          </div>
          <div class="mb-4">
            <div class="d-flex justify-content-between">
              <label for="password" class="form-label">Password</label>
              <a href="/forgot-password" class="small">Forgot password?</a>
            </div>
            <%- include('../partials/passwordInput', { id: 'password', name: 'password', autocomplete: 'current-password' }) %>
          </div>
          <button class="btn btn-espresso w-100" type="submit">Log in</button>
        </form>
        <p class="text-center mt-4 mb-0 small">New here? <a href="/register">Create an account</a></p>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
