<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-sm-10 col-md-7 col-lg-5">
    <div class="card card-cafe auth-card">
      <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
          <%- include('../partials/logo', { size: 80 }) %>
          <% if (sent) { %>
          <h1 class="h3 mt-3">Check your inbox</h1>
          <p class="text-muted mb-0">If an account exists for that email address, we've sent a link to reset your password. It expires in 1 hour.</p>
          <% } else { %>
          <h1 class="h3 mt-3">Forgot your password?</h1>
          <p class="text-muted mb-0">Enter your email address and we'll send you a link to choose a new one.</p>
          <% } %>
        </div>
        <% if (!sent) { %>
        <form method="post" action="/forgot-password" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-4">
            <label for="username" class="form-label">Email address</label>
            <input id="username" name="username" type="email" class="form-control<%= errors.username ? ' is-invalid' : '' %>" value="<%= values.username || '' %>" autocomplete="username" required autofocus>
            <% if (errors.username) { %><div class="invalid-feedback"><%= errors.username.msg %></div><% } %>
          </div>
          <button class="btn btn-espresso w-100" type="submit">Send reset link</button>
        </form>
        <% } %>
        <p class="text-center mt-4 mb-0 small"><a href="/login">Back to log in</a></p>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
