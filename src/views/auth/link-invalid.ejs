<%- include('../partials/header') %>
<div class="text-center py-5">
  <%- include('../partials/logo', { size: 96 }) %>
  <h1 class="h3 mt-3">This link isn't valid</h1>
  <p class="text-muted mb-4">It may have expired or already been used. Links work once.</p>
  <% if (kind === 'reset') { %>
  <a href="/forgot-password" class="btn btn-espresso">Request a new reset link</a>
  <% } else { %>
  <a href="/confirm-email/resend" class="btn btn-espresso">Request a new confirmation link</a>
  <% } %>
</div>
<%- include('../partials/footer') %>
