<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-sm-10 col-md-7 col-lg-5">
    <div class="card card-cafe auth-card">
      <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
          <%- include('../partials/logo', { size: 80 }) %>
          <h1 class="h3 mt-3">Choose a new password</h1>
          <p class="text-muted mb-0">Pick something you haven't used elsewhere.</p>
        </div>
        <form method="post" action="/reset-password/<%= token %>" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="password" class="form-label">New password</label>
            <%- include('../partials/passwordInput', { id: 'password', name: 'password', autocomplete: 'new-password', minlength: 8, autofocus: true, error: errors.password }) %>
          </div>
          <div class="mb-4">
            <label for="confirmPassword" class="form-label">Confirm new password</label>
            <%- include('../partials/passwordInput', { id: 'confirmPassword', name: 'confirmPassword', autocomplete: 'new-password', error: errors.confirmPassword }) %>
          </div>
          <button class="btn btn-espresso w-100" type="submit">Change password</button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
