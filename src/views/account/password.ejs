<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-sm-10 col-md-7 col-lg-5">
    <div class="card card-cafe">
      <div class="card-body p-4 p-md-5">
        <h1 class="h3 mb-3"><i class="bi bi-key me-2 text-copper"></i>Change password</h1>
        <% if (forced) { %>
        <div class="alert alert-warning" role="alert">
          An admin has given you a temporary password. Please choose a new one to continue.
        </div>
        <% } %>
        <form method="post" action="/account/password" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="currentPassword" class="form-label"><%= forced ? 'Temporary password' : 'Current password' %></label>
            <input id="currentPassword" name="currentPassword" type="password" class="form-control<%= errors.currentPassword ? ' is-invalid' : '' %>" autocomplete="current-password" required autofocus>
            <% if (errors.currentPassword) { %><div class="invalid-feedback"><%= errors.currentPassword.msg %></div><% } %>
          </div>
          <div class="mb-3">
            <label for="newPassword" class="form-label">New password</label>
            <input id="newPassword" name="newPassword" type="password" class="form-control<%= errors.newPassword ? ' is-invalid' : '' %>" autocomplete="new-password" required minlength="8">
            <% if (errors.newPassword) { %><div class="invalid-feedback"><%= errors.newPassword.msg %></div><% } %>
          </div>
          <div class="mb-4">
            <label for="confirmPassword" class="form-label">Confirm new password</label>
            <input id="confirmPassword" name="confirmPassword" type="password" class="form-control<%= errors.confirmPassword ? ' is-invalid' : '' %>" autocomplete="new-password" required>
            <% if (errors.confirmPassword) { %><div class="invalid-feedback"><%= errors.confirmPassword.msg %></div><% } %>
          </div>
          <button class="btn btn-espresso w-100" type="submit">Update password</button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
